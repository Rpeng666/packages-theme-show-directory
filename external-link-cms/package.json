{
  "name": "fake-jarvis-external-link-cms",
  "version": "0.1.0",
  "description": "Standalone external link management CMS for Next.js SaaS apps - badge bar, sr-only link injector, admin CRUD, reciprocal link checker",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema/postgres": {
      "types": "./src/schema/postgres.ts",
      "import": "./src/schema/postgres.ts",
      "default": "./src/schema/postgres.ts"
    },
    "./schema/mysql": {
      "types": "./src/schema/mysql.ts",
      "import": "./src/schema/mysql.ts",
      "default": "./src/schema/mysql.ts"
    },
    "./schema/sqlite": {
      "types": "./src/schema/sqlite.ts",
      "import": "./src/schema/sqlite.ts",
      "default": "./src/schema/sqlite.ts"
    },
    "./i18n/en": {
      "types": "./src/i18n/en.ts",
      "import": "./src/i18n/en.ts",
      "default": "./src/i18n/en.ts"
    },
    "./i18n/zh": {
      "types": "./src/i18n/zh.ts",
      "import": "./src/i18n/zh.ts",
      "default": "./src/i18n/zh.ts"
    }
  },
  "bin": {
    "fake-jarvis-external-link-cms": "./src/cli/init.ts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0",
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "zod": ">=3.0.0",
    "@tanstack/react-table": ">=8.0.0"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
