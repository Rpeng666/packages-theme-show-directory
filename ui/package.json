{
  "name": "@template/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Theme-able component primitives + sections — contracts (reusable across themes) + per-theme implementations + runtime registry.",
  "main": "./src/index.tsx",
  "module": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./themes/pixel/sections/cleaner": {
      "types": "./src/themes/pixel/sections/cleaner/index.ts",
      "import": "./src/themes/pixel/sections/cleaner/index.ts",
      "default": "./src/themes/pixel/sections/cleaner/index.ts"
    },
    "./themes/pixel/sections/*": {
      "types": "./src/themes/pixel/sections/*.tsx",
      "import": "./src/themes/pixel/sections/*.tsx",
      "default": "./src/themes/pixel/sections/*.tsx"
    },
    "./themes/pixel/header": {
      "types": "./src/themes/pixel/header/index.tsx",
      "import": "./src/themes/pixel/header/index.tsx",
      "default": "./src/themes/pixel/header/index.tsx"
    },
    "./themes/default/sections/*": {
      "types": "./src/themes/default/sections/*.tsx",
      "import": "./src/themes/default/sections/*.tsx",
      "default": "./src/themes/default/sections/*.tsx"
    }
  },
  "dependencies": {
    "@pxlkit/core": "workspace:*",
    "@pxlkit/gamification": "workspace:*",
    "@pxlkit/ui": "workspace:*",
    "@pxlkit/weather": "workspace:*",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@pxlkit/ui-kit": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.543.0",
    "react": "19.2.1",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
