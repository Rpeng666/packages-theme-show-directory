{
  "name": "@template/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Theme-able component primitives + sections — contracts (reusable across themes) + per-theme implementations + runtime registry.",
  "main": "./src/index.tsx",
  "module": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./themes/pixel/sections/cleaner": {
      "types": "./src/themes/pixel/sections/cleaner/index.ts",
      "import": "./src/themes/pixel/sections/cleaner/index.ts",
      "default": "./src/themes/pixel/sections/cleaner/index.ts"
    },
    "./themes/pixel/sections/perler-beads": {
      "types": "./src/themes/pixel/sections/perler-beads/index.ts",
      "import": "./src/themes/pixel/sections/perler-beads/index.ts",
      "default": "./src/themes/pixel/sections/perler-beads/index.ts"
    },
    "./themes/pixel/sections/*": {
      "types": "./src/themes/pixel/sections/*.tsx",
      "import": "./src/themes/pixel/sections/*.tsx",
      "default": "./src/themes/pixel/sections/*.tsx"
    },
    "./themes/pixel/header": {
      "types": "./src/themes/pixel/header/index.tsx",
      "import": "./src/themes/pixel/header/index.tsx",
      "default": "./src/themes/pixel/header/index.tsx"
    },
    "./themes/default/sections/*": {
      "types": "./src/themes/default/sections/*.tsx",
      "import": "./src/themes/default/sections/*.tsx",
      "default": "./src/themes/default/sections/*.tsx"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@pxlkit/core": "workspace:*",
    "@pxlkit/gamification": "workspace:*",
    "@pxlkit/ui": "workspace:*",
    "@pxlkit/ui-kit": "workspace:*",
    "@pxlkit/weather": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.543.0",
    "moment": "^2.30.1",
    "motion": "^12.23.12",
    "next-intl": "4.3.6",
    "next-themes": "^0.4.6",
    "overtype": "^1.2.6",
    "react": "19.2.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-use-measure": "^2.1.7",
    "recharts": "2.15.4",
    "rough-notation": "^0.5.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.2"
  }
}
